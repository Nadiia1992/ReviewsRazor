@page
@model ReviewsRazor.Pages.RegisterModel

@{
    ViewBag.Title = "Реєстрація";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h2 class="card-title text-center mb-4">Реєстрація</h2>
                <form asp-page="Register">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="reg.FirstName" class="form-control" placeholder="Ім'я" />
                                <label asp-for="reg.FirstName">Ім'я</label>
                                <span asp-validation-for="reg.FirstName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="reg.LastName" class="form-control" placeholder="Прізвище" />
                                <label asp-for="reg.LastName">Прізвище</label>
                                <span asp-validation-for="reg.LastName" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="reg.Login" class="form-control" placeholder="Логін" />
                        <label asp-for="reg.Login">Логін</label>
                        <span asp-validation-for="reg.Login" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="reg.Email" class="form-control" placeholder="Email" />
                        <label asp-for="reg.Email">Email</label>
                        <span asp-validation-for="reg.Email" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="reg.Password" class="form-control" placeholder="Пароль" />
                        <label asp-for="reg.Password">Пароль</label>
                        <span asp-validation-for="reg.Password" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="reg.PasswordConfirm" class="form-control" placeholder="Підтвердження пароля" />
                        <label asp-for="reg.PasswordConfirm">Підтвердження пароля</label>
                        <span asp-validation-for="reg.PasswordConfirm" class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">Зареєструватися</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}