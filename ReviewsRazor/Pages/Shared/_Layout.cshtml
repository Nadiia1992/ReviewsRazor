<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - La Pergola </title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container">
                <a style="color:#DBD6D2; font-family:Georgia, serif; font-size: 20px; text-decoration: none;" asp-area="" asp-controller="" asp-action="Index">La Pergola</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarTogglerDemo03" aria-controls="navbarTogglerDemo03" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="login">Вхід</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"asp-page="Register">Реєстрація</a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="full-width-block">
        <div class="text-side">
            <h1>La Pergola</h1>
            <p>Місце, про яке хочеться розповісти.</p>
        </div>

        <div class="image-side">
            <img src="/picture/main.jpg" alt="image">
        </div>
    </div>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer>
        <div class="container text-right footer-text">
            &copy; @DateTime.Now.Year - Відгуки.
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>